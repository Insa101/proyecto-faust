# 8. Beneficio de apostar a +2.5 goles
# ⚠️ ADVERTENCIA: Mira en colnames() si el nombre es 'BbAv.2.5' o similar (ej: 'preciomd_eurMw')
res_over_goles <- df_apuestas %>%
group_by(HomeTeam) %>%
summarise(
B_Over = mean(ifelse((FTHG + FTAG) > 2.5, (BbAv.2.5 - 1), -1), na.rm = TRUE)
)
