res_fijo <- df_apuestas %>%
summarise(
n_partidos = n(),
b1 = mean(ifelse(FTHG > FTAG, (B365H - 1), -1), na.rm = TRUE),
bx = mean(ifelse(FTHG == FTAG, (B365D - 1), -1), na.rm = TRUE),
b2 = mean(ifelse(FTHG < FTAG, (B365A - 1), -1), na.rm = TRUE)
)
